FROM python:3.12-slim

LABEL maintainer="Delusional Club Industries <core@delusional.club>"
LABEL description="ShinVPN High-Performance Encrypted Server Daemon"

# Install system networking tools & kernel module utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    iptables \
    iproute2 \
    procps \
    kmod \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY . .
RUN pip install --no-cache-dir -e .

# Expose UDP and Stealth ports
EXPOSE 51820/udp
EXPOSE 8443/tcp

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import socket; s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.connect(('127.0.0.1', 51820)); s.close()" || exit 1

ENTRYPOINT ["shinvpn", "server", "--config", "/app/server.json"]
